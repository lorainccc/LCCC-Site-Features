{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lccc-site-blocks/lc-handshake-feed",
	"version": "0.1.0",
	"title": "LCCC Handshake Feed",
	"category": "widgets",
	"icon": "rss",
	"description": "Block for displaying a feed from Handshake.",
	"example": {
		"attributes": {
			"feedUrl": "https://example.com/feed",
			"feedLabel": "Upcoming Events",
			"numberOfItems": 5,
			"feedCategory": "events"
		}
	},
	"attributes": {
		"lcHandshakeFeedUrl": {
			"type": "string"
		},
		"lcNumberOfItems": {
			"type": "number"
		},
		"lcHandshakeFeedName": {
			"type": "string"
		},
		"lcFeedCategory": {
			"type": "string",
			"default": "events",
			"enum": [ "events", "jobs", "fairs" ]
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"textdomain": "lccc-site-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
