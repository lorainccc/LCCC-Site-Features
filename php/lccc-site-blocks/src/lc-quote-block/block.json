{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "lccc-site-blocks/lc-quote-block",
	"version": "0.1.0",
	"title": "LCCC Quote Block",
	"category": "text",
	"icon": "format-quote",
	"description": "LCCC Custom Block for quotes with citation source.",
	"example": {
		"attributes": {
			"quoteText": "The only way to do great work is to love what you do.",
			"citation": "Steve Jobs",
			"textAlign": "center",
			"borderColor": "#0055a5",
			"borderWidth": 4
		}
	},
	"attributes": {
		"quoteText": {
			"type": "string",
			"default": ""
		},
		"citation": {
			"type": "string",
			"default": ""
		},
		"textAlign": {
			"type": "string",
			"default": "left"
		},
		"borderColor": {
			"type": "string",
			"default": "#0055a5"
		},
		"borderWidth": {
			"type": "number",
			"default": 4
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": true			
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},		
	"textdomain": "lorainccc",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
