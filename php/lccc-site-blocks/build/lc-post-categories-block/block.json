{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "lccc-site-blocks/lc-post-categories",
  "version": "0.1.0",
  "title": "LCCC Post Categories Block",
  "category": "widgets",
  "icon": "category",
  "description": "Displays the categories assigned to the current post with customizable layout and styling options.",
  "example": {
    "attributes": {
      "label": "",
      "layout": "list",
      "showCount": false
    }
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": "list",
      "enum": [
        "inline",
        "list"
      ]
    },
    "showCount": {
      "type": "boolean",
      "default": false
    },
    "separator": {
      "type": "string",
      "default": ", "
    }
  },
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": true,
      "link": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "textdomain": "lorainccc",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}